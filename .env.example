# =====================================================================
# KSRTC Local Bus Tracking System — Environment Configuration Template
# =====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Credentials (obtain from Project Settings > API in Supabase Dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key-here

# Hubballi–Dharwad Geographic Perimeter Boundaries (Validation)
MIN_LAT=15.1500
MAX_LAT=15.5500
MIN_LNG=74.9500
MAX_LNG=75.3000

# Telemetry Velocity Upper Threshold (km/h)
MAX_SPEED_KMPH=90
